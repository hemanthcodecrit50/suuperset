# Placement Copilot settings. Copy to .env and fill in; never commit .env.
# Everything here is free. Settings not listed use safe defaults (app/config.py).

# ---- 1. AI model: Google Gemini (free tier, OpenAI-compatible endpoint) ---
# Get a key at https://aistudio.google.com/apikey and paste it below.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Use the exact model id shown in AI Studio for your free-tier Flash model.
RESEARCH_MODEL=gemini-2.5-flash
# Hard cap per day across the web app, poll and agent (free quota is higher).
LLM_DAILY_REQUEST_LIMIT=500
# Seconds between requests, to stay under the per-minute limit.
LLM_MIN_INTERVAL_SECONDS=6.5

# ---- 2. Database: SQLite file, nothing to install ------------------------
DATABASE_URL=sqlite:///placement.db
# PostgreSQL instead (also free, local):
# DATABASE_URL=postgresql+psycopg://placement:placement@localhost:5432/placement

# ---- 3. Search contact -------------------------------------------------
# Wikipedia asks API users to identify themselves. Put your email or repo URL.
SEARCH_USER_AGENT=placement-copilot/0.1 (contact: you@example.com)

# ---- 4. Superset -------------------------------------------------------
# No username or password here. Use "Connect Superset" in the web app; only
# the browser session cookies are saved to this file.
SUPERSET_STORAGE_STATE=secrets/storage_state.json
TIMEZONE=Asia/Kolkata

# ---- Optional, off when blank ------------------------------------------
# Telegram alerts (the web app replaces these; leave blank to keep them off).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Extra web search; the default free sources need no key.
BRAVE_SEARCH_API_KEY=
