# ---- General -----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# ---- Database ----------------------------------------------------------
# Use a managed PostgreSQL instance (e.g. Neon) in production.
DATABASE_URL=postgresql+psycopg://placement:placement@localhost:5432/placement

# ---- Superset portal (verified from screenshots, Oct 2026) ------------
SUPERSET_BASE_URL=https://app.joinsuperset.com
SUPERSET_LOGIN_URL=https://app.joinsuperset.com/students
SUPERSET_NOTIFICATIONS_PATH=/students
SUPERSET_JOB_PROFILES_PATH=/students/jobprofiles
SUPERSET_STORAGE_STATE=secrets/storage_state.json
# Optional JSON file to override selectors in app/selectors.py (see docs/selectors.example.json)
SUPERSET_SELECTORS_FILE=

# Optional narrowing of the job list (blank = no filter)
JOB_SEARCH=
JOB_STATUS_FILTER=
JOB_TAB=

# ---- Polling / reliability --------------------------------------------
POLL_INTERVAL_MINUTES=30
POLL_NAV_TIMEOUT_MS=45000
POLL_MAX_RETRIES=3
POLL_RETRY_BASE_SECONDS=2.0
POLL_LOCK_FILE=/tmp/placement-poll.lock
HEARTBEAT_MAX_AGE_HOURS=3

# ---- Telegram ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Email (SMTP) ------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=
SMTP_USE_TLS=true

# ---- Alerts ------------------------------------------------------------
ALERT_DIGEST_HOUR=8
ALERT_MAX_ATTEMPTS=5

# ---- AI / research -----------------------------------------------------
# Two options. See docs/ai_setup.md.
#
# Option A (recommended, free + private): local Ollama
#   ollama serve
#   ollama pull llama3.1
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:11434/v1
RESEARCH_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# ---- Search toolbox (week 1) -------------------------------------------
# auto = Wikipedia + GDELT news + DuckDuckGo fallback (+ Brave when keyed).
# Explicit: auto | composite | wikipedia | gdelt | brave | duckduckgo
SEARCH_BACKEND=auto
SEARCH_CACHE_DIR=.cache/search
SEARCH_CACHE_TTL_HOURS=168
SEARCH_TIMEOUT_SECONDS=20
SEARCH_MAX_RESULTS=5
SEARCH_GDELT_TIMESPAN=2y
# Wikimedia asks for a descriptive agent with a real contact/repo URL.
SEARCH_USER_AGENT=placement-intelligence/0.1 (contact: local@example.invalid)
# Optional free-tier Brave Search key; leave blank to skip that backend.
BRAVE_SEARCH_API_KEY=

# ---- Page fetch / verification -----------------------------------------
# Comma-separated allow-list (subdomains included). Per-call extras are allowed.
FETCH_PAGE_ALLOWED_DOMAINS=wikipedia.org,wikimedia.org,wikidata.org,github.com,medium.com,dev.to,stackoverflow.com,reuters.com,bloomberg.com,techcrunch.com,economictimes.indiatimes.com,thehindu.com,business-standard.com,livemint.com,moneycontrol.com,yourstory.com,inc42.com,indianexpress.com,timesofindia.indiatimes.com
FETCH_PAGE_MAX_BYTES=2000000
FETCH_PAGE_MAX_CHARS=20000
FETCH_PAGE_TIMEOUT_SECONDS=20
FETCH_PAGE_CACHE_TTL_HOURS=168

# Option B: OpenCode inference (needs a Console service account key; paid
# models only — the free tier is restricted to use inside OpenCode itself).
#   OPENAI_API_KEY=<service account key>
#   OPENAI_BASE_URL=https://opencode.ai/inference/openai/v1
#   RESEARCH_MODEL=kimi-k2.6
